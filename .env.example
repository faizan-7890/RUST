# Cloud Functions / PostgreSQL connection (never commit real .env files)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wasm_studio
PG_SSL=false

# Firebase Project & Storage
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# API CORS allowlist (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5000

# Frontend Vite API override (optional; defaults to /api when hosted on Firebase)
VITE_API_BASE_URL=http://127.0.0.1:5001/your-firebase-project-id/us-central1/api
